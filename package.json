{
  "name": "prompter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A voice-following teleprompter for Outline documents",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server --import tsx server/dev.ts",
    "build": "react-router typegen && react-router build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check:ui": "tinyrack-ui-check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm lint && pnpm check:ui && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@tinyrack/ui": "^0.35.1",
    "hono": "^4.13.18",
    "isbot": "^5.2.3",
    "lucide-react": "^1.73.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
